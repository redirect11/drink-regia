rules_version = '2';

// LA REGIA (REQ-FLOTTA-003, REQ-FLOTTA-005): i clienti vedono solo il
// proprio documento; l'elenco, le istanze e le richieste le governa chi ha
// il claim admin. La regia non contiene mai i dati operativi dei locali.
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticato() { return request.auth != null; }
    function admin() { return autenticato() && request.auth.token.admin == true; }
    function mio(uid) { return autenticato() && request.auth.uid == uid; }

    // Il titolare: nasce alla registrazione, lo tocca solo lui (o l'admin).
    // Piano e abbonamento li scrive la regia (Functions/admin), non il
    // cliente: qui si impedisce che un cliente si assegni un piano da solo.
    match /clienti/{uid} {
      allow read: if mio(uid) || admin();
      allow create: if mio(uid)
        && request.resource.data.keys().hasOnly(['uid', 'versione_schema', 'email', 'nome_locale', 'slug', 'locale', 'fatturazione', 'referente', 'consensi', 'creato_il'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.slug.matches('^[a-z][a-z0-9-]{4,28}[a-z0-9]$')
        && request.resource.data.fatturazione.partita_iva.matches('^[0-9]{11}$')
        && request.resource.data.consensi.termini_il is string
        && request.resource.data.consensi.privacy_il is string;
      // `interna` ed `esistente` (REQ-AI-003) li mette solo l'admin: un
      // titolare che se li scrivesse da sé uscirebbe dalla sospensione dei
      // morosi. La sospensione legge comunque il segno sull'istanza.
      allow update: if admin()
        || (mio(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['piano', 'abbonamento', 'uid', 'slug', 'interna', 'esistente']));
      allow delete: if admin();
    }

    // L'istanza di un cliente: la scrive il provisioning (service account) o
    // l'admin; il titolare la legge.
    match /istanze/{slug} {
      allow read: if admin() || (autenticato() && resource.data.uid == request.auth.uid);
      allow write: if admin();
    }

    // La richiesta di attivazione: la scrive SOLO la Function
    // `chiediAttivazione` (Admin SDK, fuori da queste regole) dopo aver
    // riletto cliente e abbonamento; il titolare la legge, l'admin la
    // autorizza, rifiuta o rilancia. Audit del 22/10/2026, C2: prima la
    // creava il browser e le regole non controllavano né lo slug né
    // l'abbonamento, così chiunque registrato si attivava gratis o sullo
    // slug di un altro. Nessuna create dai client, a nessuna condizione.
    match /richieste/{slug} {
      allow read: if admin() || (autenticato() && resource.data.uid == request.auth.uid);
      allow create: if false;
      allow update, delete: if admin();
    }

    // Il cassetto AI di un'installazione (REQ-AI-003): credito, tetto,
    // speso del mese, lo storico dei consumi e delle ricariche. Lo scrivono
    // solo le Functions (Admin SDK, fuori da queste regole): il titolare lo
    // legge, nessun client lo tocca. L'impronta della chiave
    // dell'installazione sta in `riservato`, che non legge nessuno.
    match /ai/{slug} {
      allow read: if admin() || (autenticato() && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /consumi/{id} {
        allow read: if admin() || (autenticato() && get(/databases/$(database)/documents/ai/$(slug)).data.uid == request.auth.uid);
        allow write: if false;
      }
      match /ricariche/{id} {
        allow read: if admin() || (autenticato() && get(/databases/$(database)/documents/ai/$(slug)).data.uid == request.auth.uid);
        allow write: if false;
      }
      match /riservato/{doc} {
        allow read, write: if false;
      }
    }

    // Le impostazioni della regia (REQ-FLOTTA-011): il deploy automatico.
    match /impostazioni/{doc} {
      allow read: if autenticato();
      allow write: if admin();
    }
  }
}
