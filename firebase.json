{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "node -e \"const p=require('path'),d=process.env.RESOURCE_DIR;require('fs').copyFileSync(p.join(d,'..','piani.json'),p.join(d,'piani.json'))\""
    ]
  }
}
