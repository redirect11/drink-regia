# Configurazione NON segreta delle Functions della regia (REQ-FLOTTA-006,
# REQ-FLOTTA-009). I segreti (GITHUB_DISPATCH_TOKEN,
# PROVISIONING_CALLBACK_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# ANTHROPIC_API_KEY) stanno in Secret Manager del progetto.
#
# I workflow della flotta stanno nella regia dal 29/10/2026
# (docs/flotta-nella-regia.md): GITHUB_REPO è questo repository e
# FLOTTA_REF il suo ramo con i workflow (main: GitHub lancia a comando solo
# i workflow che stanno sul ramo principale).
GITHUB_REPO=redirect11/drink-regia
FLOTTA_REF=main
# La versione di tana-drink da cui si compila l'app dei locali: di norma
# main (l'ultimo rilascio). Finché la flotta non è merged, feature/flotta.
APP_REF=feature/flotta
# Quale environment della flotta: produzione (flotta) o test (flotta-test).
FLOTTA_AMBIENTE=produzione

# Per progetto: functions/.env.drink-regia (produzione) e
# functions/.env.drink-regia-test (test) vincono su questo file.
