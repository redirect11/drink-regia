# Configurazione NON segreta delle Functions in PRODUZIONE (drink-regia):
# Firebase la legge sopra functions/.env quando il deploy è su quel
# progetto. APP_REF è main, come in functions/.env (lì il perché).
# Niente segreti.
APP_REF=main
FLOTTA_AMBIENTE=produzione
# L'indirizzo della regia che la licenza dà all'app (BUG-125 di tana-drink).
REGIA_URL=https://drink-regia.web.app
# Il bucket degli archivi di eliminazione di questa regia (REQ-FLOTTA-014,
# infra/README.md), lo stesso di vars.ARCHIVIO_BUCKET dell'environment
# flotta: dal 09/11/2026 il callback non lo dichiara più, lo sa la regia.
ARCHIVIO_BUCKET=drink-regia-archivio

# LA FEDERAZIONE DELLE IDENTITÀ CON ANTHROPIC (REQ-AI-003): come sul test
# (functions/.env.drink-regia-test), con un account Google e una regola
# propri della produzione: l'account creato da `node scripts/account-ai.mjs
# --progetto drink-regia` e la regola gcp-drink-regia nella Console
# Anthropic (06/11/2026), che porta all'account di servizio Anthropic
# drink-regia nella stessa area di lavoro «drink» del test. Sono
# identificativi, non segreti. Finché ANTHROPIC_FEDERATION_RULE_ID è vuoto
# si usa la chiave del segreto ANTHROPIC_API_KEY.
AI_SERVICE_ACCOUNT=ai-regia@drink-regia.iam.gserviceaccount.com
ANTHROPIC_FEDERATION_RULE_ID=fdrl_012RAVVwF949o8Kyga5HGu4W
ANTHROPIC_ORGANIZATION_ID=2df31bf9-c728-4ba1-be52-28469dc0e99e
ANTHROPIC_SERVICE_ACCOUNT_ID=svac_01JN5U1DiagLL7UDu5beaSHN
ANTHROPIC_WORKSPACE_ID=wrkspc_01FxLtaTVxWE6uaeduZoui8e

# L'ACCOUNT CON CUI GIRANO LE FUNCTIONS (audit del 09/11/2026, finding 3):
# come sul test (functions/.env.drink-regia-test, lì i tre passi), con
# l'account creato da `node scripts/account-runtime.mjs --progetto
# drink-regia`. Accesa il 14/11/2026, nell'ordine: lo script (con
# `--locale tana-drink`, che dà all'account sulla Tana i tre ruoli del
# Terraform), REGIA_SA_EMAIL nell'environment flotta, questa riga; vale
# dal primo deploy che la porta. Daniele: «iniziamo».
RUNTIME_SERVICE_ACCOUNT=runtime-regia@drink-regia.iam.gserviceaccount.com
