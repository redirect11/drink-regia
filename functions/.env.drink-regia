# Configurazione NON segreta delle Functions in PRODUZIONE (drink-regia):
# Firebase la legge sopra functions/.env quando il deploy è su quel
# progetto. APP_REF è main, come in functions/.env (lì il perché).
# Niente segreti.
APP_REF=main
FLOTTA_AMBIENTE=produzione
# L'indirizzo della regia che la licenza dà all'app (BUG-125 di tana-drink).
REGIA_URL=https://drink-regia.web.app
